     (next.diff(it).affectedKeys().hasOnly(['rolledSub'])&&next.rolledSub==sub));
  }
  function gearReturn(uid,a,b) {
   let p=proof(uid);let r=get(path(uid,'hd3d_growth_runs',uid+'~'+p.token)).data.row;
   let c=catalog(r.stage);let got=p.level*8+int(p.kills / 3);let x=a.gear.stats;let y=b.gear.stats;
   return !exists(path(uid,'hd3d_growth_investments',uid+'~normal~'+p.token))&&p.op=='gear_run_return'&&gearCommon(uid,a,b)&&p.request=='run-'+p.token&&c.hard==false&&r.done&&!r.won&&
