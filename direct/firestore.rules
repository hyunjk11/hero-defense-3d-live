    after.stats.diff(before.stats).affectedKeys().hasOnly(['souls'])&&after.stats.souls==before.stats.get('souls',0)+c.souls&&
    codexMark(after.codex,before.codex,it);
  }
  function gearDismantle(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;let it=before.inv[p.pos];
   return p.op=='gear_dismantle'&&gearCommon(uid,a,b)&&gearItem(it)&&!it.unique&&it.id==p.token&&unEquipped(before.eq,it.id)&&
    after.diff(before).affectedKeys().hasOnly(['inv','bagIds'])&&after.inv==before.inv.removeAll([it])&&
    after.inv.size()==before.inv.size()-1&&after.bagIds==before.bagIds.removeAll([it.id])&&a.souls==b.souls&&
    a.mat.diff(b.mat).affectedKeys().hasOnly(['steel','crystal'])&&
    a.mat.steel==b.mat.steel+[2,4,8,12,20][it.g]+it.e*2&&
    a.mat.crystal==b.mat.crystal+[0,0,1,3,8][it.g]+int(it.e / 3);
