  function normalPath(uid) { return path(uid,'hd3d_growth_investments',uid+'~normal~'+proof(uid).token); }
  function normalDropList(uid,z) {let memoProof=proof(uid);
    let v=get(path(uid,'hd3d_growth_investments',uid+'~drops~'+memoProof.token)).data.row.result;
    return v.action=='normal_manifest'&&v.token==memoProof.token&&v.ref==z.dropManifest&&v.drops==z.drops;
   }
  function normalDrops(uid,z,b) {
    let d=z.drops;let n=d.size();
    // The actual v34 stage catalog has at most four boss spawns, including 10-6.
    return n<=4&&(n==0?z.dropManifest=='':normalDropList(uid,z))&&
     (n==0||unusedDrop(d[0],b.gear))&&(n<2||unusedDrop(d[1],b.gear))&&(n<3||unusedDrop(d[2],b.gear))&&(n<4||unusedDrop(d[3],b.gear));
   }
  function normalQuest(a,b,z) {
   let old=b.hq.get(z.hero,{});let next=a.hq[z.hero];let s=catalog(z.stage);
   return a.hq.diff(b.hq).affectedKeys().hasOnly([z.hero])&&next.diff(old).affectedKeys().hasOnly(['clr','boss'])&&
    next.clr==old.get('clr',0)+1&&next.boss==old.get('boss',0)+(s.boss?1:0)&&small(next.clr,1000000000)&&small(next.boss,1000000000);
  }
  function normalSettle(uid,a,b) {
   let rp=normalPath(uid);let z=getAfter(rp).data.row.result;let x=a.gear.stats;let y=b.gear.stats;
   // Cross-linked progress and entitlement must BOTH be written in this commit.
   // Validate drop references here, and run/currency arithmetic on the receipt,
   // so each independently enforced write stays below the Rules expression cap.
   return !exists(rp)&&getAfter(rp).data.commitRevision==request.resource.data.commitRevision&&normalDrops(uid,z,b)&&
    a.diff(b).affectedKeys().hasOnly(['souls','gear','st','hq','starRw','starsTotal','present'])&&a.souls==b.souls+z.souls&&
    a.present.toSet()==b.present.toSet().union((z.won?['souls','st','hq','starRw']:['souls']).toSet())&&
    a.gear.diff(b.gear).affectedKeys().hasOnly(['stats','present'])&&a.gear.present.toSet()==b.gear.present.toSet().union(['stats'].toSet())&&x.diff(y).affectedKeys().hasOnly(['runs','kills','waves','souls'])&&
    x.runs==y.get('runs',0)+1&&x.kills==y.get('kills',0)+z.kills&&x.waves==y.get('waves',0)+z.wave&&x.souls==y.get('souls',0)+z.souls&&
