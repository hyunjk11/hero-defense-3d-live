      after.inv==before.inv.concat([next])&&after.stor==before.stor.removeAll([it])&&after.stor.size()==before.stor.size()-1&&
      after.bagIds==before.bagIds.concat([it.id])&&after.storedIds==before.storedIds.removeAll([it.id])):
     (before.stor.size()<60+before.storX*10&&!(it.id in before.storedIds)&&unEquipped(before.eq,it.id)&&
      after.stor==before.stor.concat([it])&&after.inv==before.inv.removeAll([it])&&after.inv.size()==before.inv.size()-1&&
      after.storedIds==before.storedIds.concat([it.id])&&after.bagIds==before.bagIds.removeAll([it.id])));
  }
  function gearExpand(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;let receipt=path(uid,'hd3d_growth_investments',uid+'~gear~'+p.request);
   return p.op=='gear_expand'&&before.storX<4&&p.pay in ['steel','souls']&&
    a.diff(b).affectedKeys().hasOnly(['souls','mat','gear'])&&
    after.diff(before).affectedKeys().hasOnly(['present','storX'])&&after.storX==before.storX+1&&
    after.present.size()<=8&&after.present.toSet()==before.present.toSet().union(['storX'].toSet())&&
    !exists(receipt)&&getAfter(receipt).data.commitRevision==request.resource.data.commitRevision&&
    (p.pay=='souls'?(a.mat==b.mat&&a.souls==b.souls-[500,900,1500,2400][before.storX]):
     (a.souls==b.souls&&a.mat.diff(b.mat).affectedKeys().hasOnly(['steel'])&&a.mat.steel==b.mat.steel-[120,200,320,480][before.storX]));
  }
  function gearEnhance(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;let it=before.inv[p.pos];let next=after.inv[p.pos];
    // v34 ordinary enhancement is client RNG. Validate costs and one attempt;
    // a valid paid success is NOT proof of a fair random draw.
    return p.op=='gear_enhance'&&gearCommon(uid,a,b)&&gearItem(it)&&it.id==p.token&&it.e<10&&
    after.diff(before).affectedKeys().hasOnly(['inv'])&&next.diff(it).affectedKeys().hasOnly(['e','hasE'])&&
    (next.e==it.e+1||(it.e>0&&next.e==it.e))&&next.hasE==true&&after.inv.size()==before.inv.size()&&
    after.inv.removeAll([next])==before.inv.removeAll([it])&&
    a.souls==b.souls-10*(it.e+1)*(2+it.g)&&a.mat.diff(b.mat).affectedKeys().hasOnly(['steel','crystal'])&&
    a.mat.steel==b.mat.steel-2-it.e*2&&a.mat.crystal==b.mat.crystal-(it.e>=5?it.e-4:0);
  }
  function gearCraft(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;let it=after.inv[before.inv.size()];
   let c=catalog('item-'+string(p.level)+'-'+(p.slot=='weapon'?p.hero:p.slot));let recipe=c.recipes[p.choice];
   return p.op=='gear_craft'&&gearCommon(uid,a,b)&&hero(p.hero)&&owned(uid,p.hero)&&p.level<=10&&
    (p.level==0||b.st.get(string(p.level)+'-6',0)>0)&&before.inv.size()<40&&
    it.s==p.slot&&it.c==p.level&&it.h==(p.slot=='weapon'?p.hero:'')&&it.g in recipe.grades&&it==getAfter(path(uid,'hd3d_growth_investments',uid+'~gear~'+p.request)).data.row.result.it&&
    !(it.id in before.bagIds)&&!(it.id in before.storedIds)&&!(it.id in before.chestItemIds)&&
    after.diff(before).affectedKeys().hasOnly(['inv','bagIds','codex'])&&after.inv==before.inv.concat([it])&&after.bagIds==before.bagIds.concat([it.id])&&
    a.souls==b.souls-recipe.cost.souls&&a.mat.diff(b.mat).affectedKeys().hasOnly(['steel','crystal'])&&
    a.mat.steel==b.mat.steel-recipe.cost.steel&&a.mat.crystal==b.mat.crystal-recipe.cost.crystal&&codexMark(after.codex,before.codex,it);
  }
  function gearReroll(uid,a,b) {
   let p=proof(uid);let it=b.gear.inv[p.pos];let c=catalog('item-0-armor').grades[it.g];
   let result=getAfter(path(uid,'hd3d_growth_investments',uid+'~gear~'+p.request)).data.row.result;
   return p.op=='gear_reroll'&&gearCommon(uid,a,b)&&gearItem(it)&&it.id==p.token&&!it.unique&&it.g>0&&
    a.gear==b.gear&&a.souls==b.souls&&a.mat.diff(b.mat).affectedKeys().hasOnly(['steel'])&&a.mat.steel==b.mat.steel-[0,25,40,60,90][it.g]&&
    result.action=='reroll'&&result.item==it.id&&validSubs(result.sub,it.mainKey,c);
  }
  function gearApply(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;let it=before.inv[p.pos];let next=after.inv[p.pos];
   let result=get(path(uid,'hd3d_growth_investments',uid+'~gear~'+p.source)).data.row.result;
   // The immutable paid reroll receipt was already validated at creation.
   let sub=result.sub;
   return p.op=='gear_reroll_apply'&&gearCommon(uid,a,b)&&p.request=='apply-'+p.source&&gearItem(it)&&it.id==p.token&&!it.unique&&it.g>0&&
    result.action=='reroll'&&result.item==it.id&&result.ok&&
