  function gearMove(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;let take=p.op=='gear_take';
   let it=(take?before.stor:before.inv)[p.pos];let next=take?after.inv[after.inv.size()-1]:it;
   return p.op in ['gear_take','gear_store']&&gearCommon(uid,a,b)&&gearItem(it)&&it.id==p.token&&
    after.diff(before).affectedKeys().hasOnly(['inv','stor','bagIds','storedIds'])&&a.mat==b.mat&&a.souls==b.souls&&
    (take?(before.inv.size()<40&&!(it.id in before.bagIds)&&
