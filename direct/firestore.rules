    eqHero(after.eq.get('warrior',{}),before.eq.get('warrior',{}),'warrior',p.hero,sl,it.id)&&eqHero(after.eq.get('gunner',{}),before.eq.get('gunner',{}),'gunner',p.hero,sl,it.id)&&
    eqHero(after.eq.get('fighter',{}),before.eq.get('fighter',{}),'fighter',p.hero,sl,it.id)&&eqHero(after.eq.get('mechanic',{}),before.eq.get('mechanic',{}),'mechanic',p.hero,sl,it.id);
  }
  function gearUnequip(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;
   return p.op=='gear_unequip'&&gearCommon(uid,a,b)&&hero(p.hero)&&owned(uid,p.hero)&&p.slot in ['weapon','armor','acc']&&
    after.diff(before).affectedKeys().hasOnly(['eq'])&&after.eq.diff(before.eq).affectedKeys().hasOnly([p.hero])&&
    after.eq[p.hero].diff(before.eq[p.hero]).affectedKeys().hasOnly([p.slot])&&p.slot in before.eq[p.hero]&&!(p.slot in after.eq[p.hero])&&
    a.mat==b.mat&&a.souls==b.souls;
  }
  function gearCodex(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;let ch=string(p.level);let row=p.choice;
   let c=catalog('codex-'+ch);let bits=before.codex.get(ch,{});let rw=row=='all'?c.rewards.all:c.rewards.row;
   return p.op=='gear_codex'&&gearCommon(uid,a,b)&&p.level==c.ch&&p.token==ch+':'+row&&!(p.token in before.codexRw)&&
    (row in c.rows||row=='all')&&after.diff(before).affectedKeys().hasOnly(['codexRw'])&&after.codexRw==before.codexRw.concat([p.token])&&
    a.souls==b.souls+rw.get('souls',0)&&a.mat.diff(b.mat).affectedKeys().hasOnly(['crystal','essence'])&&
    a.mat.crystal==b.mat.crystal+rw.get('crystal',0)&&a.mat.get('essence',0)==b.mat.get('essence',0)+rw.get('essence',0)&&
    (row=='all'?(bits.get('mage',0) in c.complete&&bits.get('warrior',0) in c.complete&&bits.get('archer',0) in c.complete&&
     bits.get('gunner',0) in c.complete&&bits.get('fighter',0) in c.complete&&bits.get('armor',0) in c.complete&&bits.get('acc',0) in c.complete):bits.get(row,0) in c.complete);
  }
  function townCommon(uid,a,b,key) {
    let receipt=path(uid,'hd3d_growth_investments',uid+'~gear~'+proof(uid).request);
    return !exists(receipt)&&getAfter(receipt).data.commitRevision==request.resource.data.commitRevision&&
     a.diff(b).affectedKeys().hasOnly(['souls','mat',key,'present'])&&
     a.present.toSet()==b.present.toSet().union([key].toSet())&&a.present.size()==a.present.toSet().size();
   }
  function townResearch(uid,a,b) {
    let p=proof(uid);let type=p.branch;let key=p.choice;let r=b.research.get(type,{});
    let lv=r.get(key,key=='efficiency'?r.get('start',0):0);let c=catalog('town').research[key];let cost=c.costs[lv];
    return type in ['arrow','cannon','magic']&&key in ['atk','rng','spd','efficiency']&&townCommon(uid,a,b,'research')&&
     small(lv,c.max-1)&&(c.need==0||r.get('atk',0)+r.get('rng',0)+r.get('spd',0)>=c.need)&&
     a.research.diff(b.research).affectedKeys().hasOnly([type])&&a.research[type].diff(r).affectedKeys().hasOnly([key])&&
     a.research[type][key]==lv+1&&a.souls==b.souls-cost.souls&&a.mat.diff(b.mat).affectedKeys().hasOnly([c.mat])&&a.mat[c.mat]==b.mat[c.mat]-cost[c.mat];
   }
  function townBar(uid,a,b) {
    return townCommon(uid,a,b,'barLv')&&small(b.barLv,9)&&a.barLv==b.barLv+1&&a.souls==b.souls&&
     a.mat.diff(b.mat).affectedKeys().hasOnly(['steel'])&&a.mat.steel==b.mat.steel-40-20*b.barLv;
   }
  function padDay(n) { return n<10?'0'+string(n):string(n); }
  function kstDay() { let t=request.time+duration.value(9,'h');return string(t.year())+'-'+padDay(t.month())+'-'+padDay(t.day()); }
  function townExchange(uid,a,b) {
    let n=proof(uid).level;let day=kstDay();let used=b.xch.get('d','')==day?b.xch.n:0;
    return townCommon(uid,a,b,'xch')&&n>=1&&n<=15&&small(used,15)&&used+n<=15&&
     a.xch=={'d':day,'n':used+n}&&a.souls==b.souls+30*n&&
     a.mat.diff(b.mat).affectedKeys().hasOnly(['steel'])&&a.mat.steel==b.mat.steel-10*n;
   }
  function townAdvance(uid,a,b) {
    let p=proof(uid);let c=catalog('town').advance;let old=b.adv.get(p.hero,{});let branch=old is string?old:old.get('b','');
    let current=branch in c.branches[p.hero];let count=old is map?old.get('n',1):1;let cost=current?c.switch:c.first;
    return hero(p.hero)&&owned(uid,p.hero)&&p.branch in c.branches[p.hero]&&p.branch!=branch&&townCommon(uid,a,b,'adv')&&
     a.adv.diff(b.adv).affectedKeys().hasOnly([p.hero])&&a.adv[p.hero]=={'b':p.branch,'n':current?count+1:1}&&
     a.souls==b.souls-cost.souls&&
     (current?a.mat==b.mat:(b.st.get('2-4',0)>0&&b.hq.get(p.hero,{}).get('boss',0)>=1&&
      get(path(uid,'hd3d_growth_wallet',uid)).data.row.xp[p.hero]>=totalXP(10)&&
      a.mat.diff(b.mat).affectedKeys().hasOnly(['crystal','essence'])&&
      a.mat.crystal==b.mat.crystal-cost.crystal&&a.mat.get('essence',0)==b.mat.get('essence',0)-cost.essence));
   }
  function gearChange(uid,a,b) {
   let op=proof(uid).op;
     return op=='gear_research'?townResearch(uid,a,b):op=='gear_bar'?townBar(uid,a,b):op=='gear_exchange'?townExchange(uid,a,b):op=='gear_advance'?townAdvance(uid,a,b):op=='gear_craft'?gearCraft(uid,a,b):op=='gear_reroll'?gearReroll(uid,a,b):op=='gear_reroll_apply'?gearApply(uid,a,b):op=='gear_run_return'?gearReturn(uid,a,b):op=='gear_codex'?gearCodex(uid,a,b):op=='gear_open'?gearOpen(uid,a,b):op=='gear_dismantle'?gearDismantle(uid,a,b):
    op in ['gear_store','gear_take']?gearMove(uid,a,b):op=='gear_expand'?gearExpand(uid,a,b):
    op=='gear_enhance'?gearEnhance(uid,a,b):op=='gear_equip'?gearEquip(uid,a,b):op=='gear_unequip'?gearUnequip(uid,a,b):false;
  }
  function challengeSettle(uid,a,b) {
   let rp=chPath(uid);let z=getAfter(rp).data.row.result;let x=a.gear.stats;let y=b.gear.stats;
   return !exists(rp)&&getAfter(rp).data.commitRevision==request.resource.data.commitRevision&&
    a.diff(b).affectedKeys().hasOnly(['souls','bestWave','mat','gear','present'])&&a.souls==b.souls+z.souls&&a.bestWave==z.bestWave&&
    a.mat.diff(b.mat).affectedKeys().hasOnly(['essence'])&&a.mat.get('essence',0)==b.mat.get('essence',0)+z.essence&&
    a.present.toSet()==b.present.toSet().union((z.essence>0?['souls','bestWave','mat']:['souls','bestWave']).toSet())&&
    a.gear.diff(b.gear).affectedKeys().hasOnly(['stats','present'])&&a.gear.present.toSet()==b.gear.present.toSet().union(['stats'].toSet())&&x.diff(y).affectedKeys().hasOnly(['runs','kills','waves','souls'])&&
    x.runs==y.get('runs',0)+1&&x.kills==y.get('kills',0)+z.kills&&x.waves==y.get('waves',0)+z.wave&&x.souls==y.get('souls',0)+z.souls&&
    small(x.runs,1000000000)&&small(x.kills,1000000000)&&small(x.waves,1000000000)&&small(x.souls,1000000000);
  }
  function challengeGrant(uid,a,b) {
   let rp=chPath(uid);let before=get(rp).data.row.result;let lp=chLootPath(uid,before.next);let step=getAfter(lp);let z=step.data.row.result;
   let it=z.it;let src=z.src;let c={'body':'','src':src,'id':'c'+it.id,'it':it,'souls':[4,6,10,16,30][it.g]};
   let entry=z.entry;let y={'steel':[2,4,8,12,20][it.g],'crystal':[0,0,1,3,8][it.g]};
   return !exists(lp)&&step.data.commitRevision==request.resource.data.commitRevision&&getAfter(rp).data.commitRevision==request.resource.data.commitRevision&&
    str(it.id,16)&&newItemShape(it,catalog('item-'+string(it.c)+'-'+(it.s=='weapon'?it.h:it.s)).grades[it.g])&&
    a.diff(b).affectedKeys().hasOnly(['gear','mat'])&&!(it.id in b.gear.bagIds)&&!(it.id in b.gear.storedIds)&&
    (b.gear.chests.size()<200?
     (a.mat==b.mat&&!(it.id in b.gear.chestItemIds)&&a.gear.diff(b.gear).affectedKeys().hasOnly(['chests','chestItemIds','present'])&&a.gear.present.toSet()==b.gear.present.toSet().union(['chests'].toSet())&&a.gear.chests==b.gear.chests.concat([c])&&a.gear.chestItemIds==b.gear.chestItemIds.concat([it.id])&&entry=={'it':it,'src':src,'auto':false,'chest':c.id}):
     (a.gear==b.gear&&a.mat.diff(b.mat).affectedKeys().hasOnly(['steel','crystal'])&&a.mat.steel==b.mat.steel+y.steel&&a.mat.crystal==b.mat.crystal+y.crystal&&entry=={'it':it,'src':src,'auto':true,'y':y}));
