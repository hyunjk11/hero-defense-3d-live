    small(x.runs,1000000000)&&small(x.kills,1000000000)&&small(x.waves,1000000000)&&small(x.souls,1000000000);
  }
  function eqHero(a,b,h,chosen,sl,id) { return h==chosen?(a[sl]==id&&a.diff(b).affectedKeys().hasOnly([sl])):
   (b.get(sl,'')!=id?a==b:(!(sl in a)&&a.diff(b).affectedKeys().hasOnly([sl]))); }
  function gearEquip(uid,a,b) {
   let p=proof(uid);let before=b.gear;let after=a.gear;let it=before.inv[p.pos];let sl=it.s;
   return p.op=='gear_equip'&&gearCommon(uid,a,b)&&hero(p.hero)&&owned(uid,p.hero)&&sl in ['weapon','armor','acc']&&it.id==p.token&&
    (sl!='weapon'||it.h==p.hero)&&after.diff(before).affectedKeys().hasOnly(['eq'])&&
    after.eq.keys().toSet()==before.eq.keys().toSet().union([p.hero].toSet())&&
