rules_version = '2';
// PROTOTYPE, EMULATOR ONLY. Not a production replacement for server adjudication.
// Model: hd3d_live/{uid}/{table}/{id}
// Envelope: owner (immutable UID), version (1), row (typed legacy-compatible map),
// commitRevision (integer shared by all writes in one atomic transaction).
// _activation is a trusted migration marker; _revision is a per-account CAS fence.
// progress.row.saveJson is a <=64KiB UNTRUSTED game-save blob, never an authority
// source for admin roles, bans, paid ownership or permission grants.
// Existing hd3d_* documents remain denied and are never changed by this prototype.
// Consolidated path dispatch; every original allow predicate and resolved
// validator body is retained. Literal path guards prevent unrelated access.
service cloud.firestore {
 match /databases/{database}/documents {

  match /hd3d_live/{uid}/{table}/{id} {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function demo() { return request.auth.token.aud == 'demo-hd3d-direct'; }
  function small(n,max) { return n is int && n >= 0 && n <= max; }
  function str(s,max) { return s is string && s.size() <= max; }
  function base(d,uid) {
   let keys=d.keys();
   return keys.hasAll(['owner','version','row','commitRevision']) &&
    keys.hasOnly(['owner','version','row','commitRevision','issuedAt','pingAt','closedAt']) &&
    d.owner == uid && d.version == 1 && d.row is map && small(d.commitRevision,1000000000) &&
    (!('issuedAt' in d)||d.issuedAt is timestamp) &&
    (!('pingAt' in d)||d.pingAt==null||d.pingAt is timestamp) &&
    (!('closedAt' in d)||d.closedAt==null||d.closedAt is timestamp);
  }
  function path(uid,t,id) { return /databases/$(database)/documents/hd3d_live/$(uid)/$(t)/$(id); }
  function active(uid) { return get(path(uid,'hd3d_sequences','_activation')).data.row.enabled == true &&
    !exists(path(uid,'hd3d_bans',uid)); }
  function fence(uid,d) {let revisionPath=path(uid,'hd3d_sequences','_revision');
   // The mandatory revision update checks activation/ban once for this atomic batch.
   // Without that update, the before+1/after fence cannot pass for any row.
   return d.commitRevision == getAfter(revisionPath).data.row.value &&
    d.commitRevision == get(revisionPath).data.row.value+1;
  }
  function proof(uid) { return getAfter(path(uid,'hd3d_sequences','_revision')).data.row.proof; }
  function noticeAdmin() {
   let uid=request.auth.uid;let role=path(uid,'hd3d_admins',uid);
   // UID-scoped role is provisioned by a trusted importer, never by email.
   // Preserve the existing owner's additional case-insensitive email binding.
   return active(uid)&&exists(role)&&(!get(role).data.row.get('owner',false)||
    request.auth.token.email.lower()=='owner@example.invalid');
  }
  function mail(r,uid) {
   return r.keys().hasAll(['id','user_id','title','body','reward','claimed','claimed_at','revoked','order_id','broadcast_id','created_at']) &&
    r.keys().hasOnly(['id','user_id','title','body','reward','claimed','claimed_at','revoked','order_id','broadcast_id','created_at','server_applied']) &&
    r.user_id==uid&&small(r.id,9007199254740991)&&r.id>0&&str(r.title,100)&&str(r.body,1000)&&
    r.claimed is bool&&r.revoked is bool&&str(r.created_at,32)&&
    (r.reward==null || r.reward is map);
  }
  function amAuditPath(uid,id) {return /databases/$(database)/documents/hd3d_live_mail_audit/$(uid+'~'+string(id));}
  function amLinked(uid,id) {let a=getAfter(amAuditPath(uid,id)).data;return !exists(amAuditPath(uid,id))&&a.actor==request.auth.uid&&a.target==uid&&a.mail==id&&a.at==request.time;}
  function moderationPath(actor,id) {return /databases/$(database)/documents/hd3d_live_moderation/$(actor+'~'+id);}
  function linkedModeration(uid,d) {let a=getAfter(moderationPath(request.auth.uid,d.lastRequest)).data;return !exists(moderationPath(request.auth.uid,d.lastRequest))&&a.target==uid&&a.revision==d.revision&&a.at==request.time&&a.action==(d.banned?'admin_ban':'admin_unban')&&
   (d.banned?(getAfter(path(uid,'hd3d_bans',uid)).data.row.reason==a.reason&&getAfter(path(uid,'hd3d_bans',uid)).data.row.banned_by==a.actor):!existsAfter(path(uid,'hd3d_bans',uid)));}
  function blockPath(uid) {return /databases/$(database)/documents/hd3d_live_rank_blocks/$(uid);}
  function moderationBan(uid) {let b=getAfter(blockPath(uid)).data;return noticeAdmin()&&b.updatedAt==request.time&&linkedModeration(uid,b);}
  function validBan(d) {return id==uid&&base(d,uid)&&d.row.keys().hasAll(['user_id','reason','banned_by','created_at'])&&d.row.keys().hasOnly(['user_id','reason','banned_by','created_at'])&&d.row.user_id==uid&&d.row.banned_by==request.auth.uid&&str(d.row.reason,200)&&d.row.reason.size()>=1&&str(d.row.created_at,32);}
  function writeBase(uid,d) { return owner(uid)&&demo()&&base(d,uid)&&fence(uid,d); }
  function updateBase(uid,d) { return writeBase(uid,d)&&resource.data.owner==uid&&resource.data.version==d.version; }
  function adminReadTable(t) { return t in ['hd3d_users','hd3d_profiles','hd3d_progress','hd3d_bans','hd3d_admins','hd3d_owned','hd3d_orders','hd3d_mail','hd3d_dungeon_wallet','hd3d_dungeon_runs','hd3d_spire_best','hd3d_spire_weeks','hd3d_spire_runs']; }
  function coPath(uid,rid) {return /databases/$(database)/documents/hd3d_live_order_requests/$(uid+'~'+rid);}
  function co(uid) {return getAfter(coPath(uid,proof(uid).request)).data;}
  function coLink(uid) {let p=proof(uid);let r=co(uid);return owner(uid)&&demo()&&p.op=='order_create'&&!exists(coPath(uid,p.request))&&r.uid==uid&&r.request==p.request&&r.item==p.token&&r.at==request.time;}
  function aaPath(actor,id) {return /databases/$(database)/documents/hd3d_live_admin_actions/$(actor+'~'+id);}
  function aa(uid) {let p=proof(uid);return getAfter(aaPath(p.token,p.request)).data;}
  function aaLink(uid) {let p=proof(uid);let d=aa(uid);return request.auth!=null&&demo()&&p.op=='admin_action'&&p.token==request.auth.uid&&!exists(aaPath(p.token,p.request))&&d.actor==p.token&&d.request==p.request&&d.target==uid&&d.at==request.time;}
  function spDay() { return int((request.time.toMillis() + 32400000) / 86400000); }
  function spBestPath(uid) { return path(uid,'hd3d_spire_best',uid); }
  function rankPath(uid,kind,wk) { return /databases/$(database)/documents/hd3d_live_ranks/$(kind+'~'+wk+'~'+uid); }
  function aaBase(uid,d) {return base(d,uid)&&fence(uid,d)&&aaLink(uid);}
  function coOrder(uid,id,d) {
   let r=co(uid);let guard=path(uid,'hd3d_sequences','order-pending-'+r.item);let prev=get(guard).data.row.value;
   return base(d,uid)&&fence(uid,d)&&coLink(uid)&&string(r.order)==id&&d.row==r.row&&
    !exists(path(uid,'hd3d_owned',uid+'~'+r.item))&&(prev==0||get(path(uid,'hd3d_orders',string(prev))).data.row.status!='pending')&&
    getAfter(guard).data.row.value==r.order&&getAfter(path(uid,'hd3d_sequences','hd3d_orders')).data.row.value==r.order;
  }
  function changed(d) {let a=aa(uid);let r=d.row;let b=resource.data.row;return aaBase(uid,d)&&a.action in ['admin_approve','admin_reject','admin_refund']&&a.order==r.id&&string(r.id)==id&&r.user_id==uid&&r.item==a.item&&
    (a.action=='admin_refund'?b.status=='approved'&&r.status=='refunded'&&r.diff(b).affectedKeys().hasOnly(['status','refunded_at','refund_note'])&&r.refund_note==a.reason&&str(r.refunded_at,32):b.status=='pending'&&r.status==(a.action=='admin_approve'?'approved':'rejected')&&r.diff(b).affectedKeys().hasOnly(['status','decided_at','note'])&&str(r.decided_at,32)&&(r.note==null||str(r.note,200)));}
  function createRole(d) {let a=aa(uid);return aaBase(uid,d)&&a.action=='owner_add_admin'&&id==uid&&d.row.keys().hasAll(['user_id','owner','added_by','created_at'])&&d.row.keys().hasOnly(['user_id','owner','added_by','created_at'])&&d.row.user_id==uid&&d.row.owner==false&&d.row.added_by==a.actor&&str(d.row.created_at,32);}
  function readable(t) { return t in ['hd3d_profiles','hd3d_progress','hd3d_admins','hd3d_owned','hd3d_orders','hd3d_mail','hd3d_bans','hd3d_users','hd3d_growth_wallet','hd3d_growth_runs','hd3d_growth_receipts','hd3d_growth_investments','hd3d_sequences','hd3d_dungeon_wallet','hd3d_dungeon_runs','hd3d_dungeon_buys','hd3d_spire_runs','hd3d_spire_best','hd3d_spire_weeks','hd3d_notices']; }
  function profile(r,uid) {
   return r.keys().hasAll(['id','nickname','created_at','updated_at']) &&
    r.keys().hasOnly(['id','nickname','created_at','updated_at']) && r.id==uid &&
    str(r.nickname,12)&&r.nickname.size()>0 && str(r.created_at,32)&&str(r.updated_at,32);
  }
  function userRow(r,uid,id) { return id==uid&&r.keys().hasAll(['id','email','created_at','last_sign_in_at'])&&
   r.keys().hasOnly(['id','email','created_at','last_sign_in_at'])&&r.id==uid&&r.email==request.auth.token.email&&
   str(r.email,320)&&str(r.created_at,32)&&str(r.last_sign_in_at,32); }
  function catalog(stage) { return get(/databases/$(database)/documents/hd3d_live_catalog/$(stage)).data; }
  function hardPath(uid) { return path(uid,'hd3d_growth_runs',uid+'~'+proof(uid).token); }
  function mailItemPath(uid,id,i) { return path(uid,'hd3d_growth_investments',uid+'~mailitem~'+id+'~'+string(i)); }
  function mailItemPaid(uid,id,i) { return exists(mailItemPath(uid,id,i)); }
  function hardSpec(x,ch,h,grades) {
   return x.keys().hasAll(['k','s','g','c'])&&x.keys().hasOnly(x.s=='weapon'?['k','s','g','c','h']:['k','s','g','c'])&&
    x.k=='gear'&&x.s in ['weapon','armor','acc']&&x.c==ch&&x.g in grades&&(x.s!='weapon'||x.h==h);
  }
  function hardSpecs(r,items,s) {
   let z=r.directReward;let n=items.size();let b=int(r.completed / 5);
   let t=r.won&&!z.first&&r.repeat?r.target:null;let h=t!=null&&!(t in ['armor','acc'])?t:r.hero;
   let g=s.hardGrades;
   return (n==0||hardSpec(items[0],s.ch,h,b>0?g:z.first?[3]:[0,1,2])&&(t==null||items[0].s==(t in ['armor','acc']?t:'weapon')))&&
    (n<2||hardSpec(items[1],s.ch,r.hero,b>1?g:z.first&&b==1?[3]:[0,1,2]))&&
    (n<3||hardSpec(items[2],s.ch,r.hero,b>2?g:z.first&&b==2?[3]:[0,1,2]))&&
    (n<4||hardSpec(items[3],s.ch,r.hero,z.first&&b==3?[3]:[0,1,2]))&&
    (n<5||hardSpec(items[4],s.ch,r.hero,[0,1,2]));
  }
  function spPath(uid) { return path(uid,'hd3d_spire_runs',proof(uid).request); }
  function spOldBest(uid) { return exists(spBestPath(uid))?get(spBestPath(uid)).data.row:{'user_id':uid,'best_floor':0,'best_at':null,'cleared_bosses':0,'updated_at':''}; }
  function swGrant(uid) { return get(path(uid,'hd3d_growth_investments',uid+'~spaward~'+proof(uid).source)).data.row.result; }
  function swWeekPath(uid) { return path(uid,'hd3d_spire_weeks',uid+'~'+proof(uid).source); }
  function swLast(uid) { return swGrant(uid).weekDay==spDay()-(spDay()+3)%7-7; }
  function swValid(uid) {
   let a=swGrant(uid);let w=get(swWeekPath(uid)).data.row;
   return proof(uid).op=='spire_claim_week'&&a.action=='spire_week_award'&&a.week==proof(uid).source&&a.week==w.week&&a.floor==w.best_floor&&a.floor>0&&
    a.weekDay is int&&(a.weekDay+3)%7==0&&a.weekDay+7<=spDay()&&a.rank is int&&a.rank>=1&&
    a.souls==(a.floor*30>1500?1500:a.floor*30)&&a.medals==(int(a.floor / 5)*2>25?25:int(a.floor / 5)*2)&&
    (a.rank==1?a.title=='spire_w1':a.rank<=10?a.title=='spire_w10':a.title==null)&&!w.claimed;
  }
  function swReceiptPath(uid) { return path(uid,'hd3d_growth_investments',uid+'~spclaim~'+proof(uid).source); }
  function swLinked(uid) {return !exists(swReceiptPath(uid))&&getAfter(swReceiptPath(uid)).data.commitRevision==request.resource.data.commitRevision;}
  function dgPath(uid) { return path(uid,'hd3d_dungeon_runs',proof(uid).request); }
  function dgBuyPath(uid) { return path(uid,'hd3d_growth_investments',uid+'~dgbuy~'+proof(uid).request); }
  function dgBuyResult(uid) { return getAfter(dgBuyPath(uid)).data.row.result; }
  function hardMail(uid,r) {
   let run=get(hardPath(uid)).data.row;let z=run.directReward;let items=r.reward.get('items',[]);let s=catalog(run.stage);
   return proof(uid).op=='hard_mail'&&run.done&&s.hard&&z.mail==r.id&&
    r.reward.keys().hasOnly(['souls','items'])&&r.reward.souls==z.souls&&items is list&&items.size()==z.total&&
    !r.claimed&&r.claimed_at==null&&!r.revoked&&!r.get('server_applied',false)&&r.order_id==null&&r.broadcast_id==null&&hardSpecs(run,items,s);
  }
  function spSouls(n) { let k=n>100?20:int(n / 5);return 300*k+50*k*(k+1); }
  function spMedals(n) { let k=n>100?10:int(n / 10);return 5*k+int(k*(k+1) / 2)+(n>100?(int(n / 10)-10)*10:0); }
  function spMail(uid,r) {
   let b=spOldBest(uid);let a=getAfter(spBestPath(uid)).data.row;let souls=spSouls(a.cleared_bosses)-spSouls(b.cleared_bosses);let medals=spMedals(a.cleared_bosses)-spMedals(b.cleared_bosses);
   return proof(uid).op in ['spire_ping','spire_finish']&&getAfter(spBestPath(uid)).data.commitRevision==request.resource.data.commitRevision&&a.cleared_bosses>b.cleared_bosses&&
    r.reward is map&&r.reward.keys().hasOnly(['souls','medals'])&&r.reward.get('souls',0)==souls&&r.reward.get('medals',0)==medals&&(souls>0||medals>0)&&
    !r.claimed&&!r.revoked&&!r.get('server_applied',false)&&r.claimed_at==null&&r.order_id==null&&r.broadcast_id==null&&
    getAfter(path(uid,'hd3d_sequences','hd3d_mail')).data.row.value==r.id&&getAfter(path(uid,'hd3d_sequences','hd3d_mail')).data.commitRevision==request.resource.data.commitRevision;
  }
  function swMail(uid,r) {
   let a=swGrant(uid);let z=getAfter(swReceiptPath(uid)).data.row.result;
   return swValid(uid)&&swLinked(uid)&&r.id==z.mail&&r.reward=={'souls':a.souls,'medals':a.medals}&&!r.claimed&&!r.revoked&&!r.get('server_applied',false)&&r.claimed_at==null&&r.order_id==null&&r.broadcast_id==null&&
    getAfter(path(uid,'hd3d_sequences','hd3d_mail')).data.row.value==r.id&&getAfter(path(uid,'hd3d_sequences','hd3d_mail')).data.commitRevision==request.resource.data.commitRevision;
  }
  function dgBossMail(uid,r) {
   let run=getAfter(dgPath(uid));let z=run.data.row.boss_reward;
   return proof(uid).op=='dungeon_boss_drop'&&get(dgPath(uid)).data.row.boss_reward==null&&
    run.data.commitRevision==request.resource.data.commitRevision&&z.mail==r.id&&r.reward=={'items':[z.item]}&&
    !r.claimed&&!r.revoked&&!r.get('server_applied',false)&&r.claimed_at==null&&r.order_id==null&&r.broadcast_id==null&&
    getAfter(path(uid,'hd3d_sequences','hd3d_mail')).data.row.value==r.id&&getAfter(path(uid,'hd3d_sequences','hd3d_mail')).data.commitRevision==request.resource.data.commitRevision;
  }
  function dgShopMail(uid,r) {
   let z=dgBuyResult(uid);let item=catalog('dungeon-shop')[proof(uid).token];
   return proof(uid).op=='dungeon_buy'&&z.mail==r.id&&r.reward==item.reward&&!r.claimed&&!r.revoked&&!r.get('server_applied',false)&&r.claimed_at==null&&r.order_id==null&&r.broadcast_id==null&&
    getAfter(path(uid,'hd3d_sequences','hd3d_mail')).data.row.value==r.id&&getAfter(path(uid,'hd3d_sequences','hd3d_mail')).data.commitRevision==request.resource.data.commitRevision&&getAfter(dgBuyPath(uid)).data.commitRevision==request.resource.data.commitRevision;
  }
  function dgMail(uid,r) {
   let run=getAfter(dgPath(uid)).data.row; let old=get(dgPath(uid)).data.row;
   return proof(uid).op=='dungeon_finish' && old.status=='active' && run.status=='done' &&
    run.soul_reward.mail==r.id && r.reward=={'souls':run.soul_reward.souls} &&
    !r.claimed && !r.revoked && !r.get('server_applied',false) && r.order_id==null && r.broadcast_id==null &&
    getAfter(dgPath(uid)).data.commitRevision==request.resource.data.commitRevision;
  }
  function mailItemsPaid(uid,id,m) {
   let n=m.reward==null?0:m.reward.get('items',[]).size();
   // Each immutable receipt requires its immediate predecessor. One final read
   // proves the full bounded chain without exceeding 10 document reads per write.
   return n<=10&&(n==0||mailItemPaid(uid,id,n-1));
  }
  function mailClaim(uid,d,old) {
   return proof(uid).op=='claim_mail' && proof(uid).request==string(old.row.id) && !old.row.claimed && !old.row.revoked &&
    d.row.diff(old.row).affectedKeys().hasOnly(['claimed','claimed_at','server_applied']) &&
    d.row.claimed && d.row.server_applied && str(d.row.claimed_at,32)&&mailItemsPaid(uid,proof(uid).request,old.row) &&
    getAfter(path(uid,'hd3d_progress',uid)).data.commitRevision==d.commitRevision &&
    (!(old.row.reward is map) || !('hero' in old.row.reward) || exists(path(uid,'hd3d_owned',uid+'~hero_'+old.row.reward.hero)) ||
      getAfter(path(uid,'hd3d_owned',uid+'~hero_'+old.row.reward.hero)).data.commitRevision==d.commitRevision) &&
    (!(old.row.reward is map) || old.row.reward.get('medals',0)==0 || getAfter(path(uid,'hd3d_dungeon_wallet',uid)).data.commitRevision==d.commitRevision);
  }
  function amCreate(uid,id,d) {return request.auth!=null&&demo()&&base(d,uid)&&d.commitRevision==0&&string(d.row.id)==id&&amLinked(uid,d.row.id)&&d.row==getAfter(amAuditPath(uid,d.row.id)).data.row;}
  function aaMailNew(uid,id,d) {let a=aa(uid);return aaBase(uid,d)&&a.action in ['admin_approve','admin_reject','admin_refund']&&mail(d.row,uid)&&string(d.row.id)==id&&d.row.id==a.mail&&d.row.order_id==a.order&&d.row.broadcast_id==null&&!d.row.claimed&&!d.row.revoked&&d.row.claimed_at==null&&!('server_applied' in d.row)&&(a.action=='admin_approve'?d.row.reward=={'hero':a.item.replace('hero_','')}:d.row.reward==null);}
  function aaMailRevoke(uid,d,old) {let a=aa(uid);return aaBase(uid,d)&&old.owner==uid&&!old.row.claimed&&!old.row.revoked&&d.row.diff(old.row).affectedKeys().hasOnly(['revoked'])&&d.row.revoked==true&&
   (a.action=='admin_refund'?old.row.order_id==a.order:a.action=='admin_revoke_hero'&&old.row.reward.hero==a.item.replace('hero_',''));}
  function valid_8(d) { return string(d.row.id)==id&&mail(d.row,uid); }
  function createRow_3(d) { return d.commitRevision==0?amCreate(uid,id,d):proof(uid).op=='admin_action'?aaMailNew(uid,id,d):writeBase(uid,d)&&valid_8(d)&&(proof(uid).op=='hard_mail'?hardMail(uid,d.row):proof(uid).op=='spire_claim_week'?swMail(uid,d.row):proof(uid).op=='dungeon_buy'?dgShopMail(uid,d.row):proof(uid).op=='dungeon_boss_drop'?dgBossMail(uid,d.row):proof(uid).op in ['spire_ping','spire_finish']?spMail(uid,d.row):dgMail(uid,d.row)); }
  function updateRow_4(d) { return proof(uid).op=='admin_action'?aaMailRevoke(uid,d,resource.data):updateBase(uid,d)&&valid_8(d)&&(mailClaim(uid,d,resource.data)); }
  function linkedRank(uid,kind,wk,d) { let r=getAfter(rankPath(uid,kind,wk)).data;return r.revision==d.commitRevision&&r.floor==d.row.best_floor&&r.at==d.row.best_at; }
  function spWeek(uid,d,b) {
   let r=getAfter(spPath(uid)).data.row;let a=d.row;
   return proof(uid).op in ['spire_ping','spire_finish']&&getAfter(spPath(uid)).data.commitRevision==d.commitRevision&&r.status in ['active','done']&&
    a.keys().hasOnly(['user_id','week','best_floor','best_at','claimed'])&&a.user_id==uid&&a.week==r.week&&a.best_floor==r.top_floor&&a.best_floor>b.best_floor&&a.best_floor>=r.from_floor&&
    a.best_at==request.time&&a.claimed==b.claimed&&linkedRank(uid,'week',a.week,d);
  }
  function swClaim(uid,d,b) {return swValid(uid)&&swLinked(uid)&&d.row.diff(b).affectedKeys().hasOnly(['claimed'])&&d.row.claimed;}
  function aaResetWeek(uid,id) {return aaLink(uid)&&aa(uid).action=='admin_spire_reset'&&id==uid+'~'+aa(uid).week&&resource.data.row.week==aa(uid).week&&resource.data.owner==uid;}
  function dgBuyRow(uid,d,id) {
   let r=d.row;let z=dgBuyResult(uid);
   return proof(uid).op=='dungeon_buy'&&r.keys().hasAll(['id','user_id','item','price','mail_id','created_at'])&&r.keys().hasOnly(['id','user_id','item','price','mail_id','created_at'])&&
    string(r.id)==id&&r.user_id==uid&&r.id==z.buy&&r.item==z.item&&r.price==z.price&&r.mail_id==z.mail&&str(r.created_at,32)&&
    getAfter(path(uid,'hd3d_sequences','hd3d_dungeon_buys')).data.row.value==r.id&&getAfter(path(uid,'hd3d_sequences','hd3d_dungeon_buys')).data.commitRevision==d.commitRevision&&
    getAfter(dgBuyPath(uid)).data.commitRevision==d.commitRevision;
  }
  function claimedMail(uid) {
   let m=get(path(uid,'hd3d_mail',proof(uid).request)).data.row;
   let after=getAfter(path(uid,'hd3d_mail',proof(uid).request)).data;
   return proof(uid).op=='claim_mail'&&!m.claimed&&!m.revoked&&after.row.claimed&&after.row.server_applied&&
    after.commitRevision==request.resource.data.commitRevision;
  }
  function spTitles(uid,a,b) {
   let old=spOldBest(uid).cleared_bosses;let n=getAfter(spBestPath(uid)).data.row.cleared_bosses;let added=(old<30&&n>=30?['spire_30']:[]).concat(old<50&&n>=50?['spire_50']:[]);
